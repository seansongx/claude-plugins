{
  "description": "改完样式文件后检查是否使用了设计 token",
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Write|Edit|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "node",
            "args": ["${CLAUDE_PLUGIN_ROOT}/skills/tailwind-tokens/scripts/check-tokens.mjs"],
            "timeout": 15
          }
        ]
      }
    ]
  }
}
