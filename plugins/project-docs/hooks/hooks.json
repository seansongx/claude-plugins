{
  "description": "新建 .md 前检查位置是否符合文档规范",
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Write|Edit|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "node",
            "args": ["${CLAUDE_PLUGIN_ROOT}/skills/project-docs/scripts/check-docs.mjs"],
            "timeout": 15
          }
        ]
      }
    ]
  }
}
